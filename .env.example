# URL del backend Laravel (sin barra final)
# Android emulador: http://10.0.2.2:8000
# iOS simulador / web local: http://127.0.0.1:8000
# Dispositivo físico: http://TU_IP_LAN:8000
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Firebase (mismo proyecto que buyer/admin). Sin comillas ni comas.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# false = si Firestore falla o app_enabled es false → pantalla negra
EXPO_PUBLIC_PLATFORM_ACCESS_FAIL_OPEN=false
