{
  "expo": {
    "name": "ISI Plaza",
    "slug": "isi-plaza-seller",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/isi-plaza-logo.png",
    "scheme": "isiplazaseller",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/isi-plaza-logo.png"
    },
    "android": {
      "package": "com.isiplaza.seller",
      "adaptiveIcon": {
        "backgroundColor": "#FF0000",
        "foregroundImage": "./assets/images/isi-plaza-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF0000",
          "image": "./assets/images/waiting.png",
          "resizeMode": "cover"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "ISI Plaza necesita acceso a tus fotos para el perfil y catálogo."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b6fc63ac-f616-42ac-a7dd-34ae289bb58b"
      }
    }
  }
}
