{
  "expo": {
    "name": "Odontica",
    "slug": "odontica-seller",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/isi-plaza-logo.png",
    "scheme": "isiplazaseller",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/isi-plaza-logo.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Odontica usa tu ubicación para mostrar dentistas cerca de ti."
      }
    },
    "android": {
      "package": "com.isiplaza.seller",
      "adaptiveIcon": {
        "backgroundColor": "#121660",
        "foregroundImage": "./assets/images/isi-plaza-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "navigationBar": {
        "backgroundColor": "#121660",
        "barStyle": "light-content"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121660",
          "image": "./assets/images/splash-native-transparent.png",
          "imageWidth": 1,
          "android": {
            "backgroundColor": "#121660",
            "image": "./assets/images/splash-native-transparent.png",
            "imageWidth": 1
          },
          "ios": {
            "backgroundColor": "#121660",
            "image": "./assets/images/splash-native-transparent.png",
            "imageWidth": 1
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Odontica necesita acceso a tus fotos para el perfil y consultorio."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Odontica usa tu ubicación para mostrar dentistas cerca de ti."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7f84f326-08a2-496d-933e-424be9e9a3f9"
      }
    },
    "owner": "jesus-aplify"
  }
}
